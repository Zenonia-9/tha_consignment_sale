<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_settlement_list" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.list</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoices"/>
                    <button name="action_create_commission_bill" type="object" string="Create Bills"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="period_from" optional="show"/>
                <field name="date_to" optional="show"/>
                <field name="source_location_id" optional="show"/>
                <field name="amount_total" optional="show"/>
                <field name="commission_amount" optional="show"/>
                <field name="net_amount" optional="show"/>
                <field name="picking_state" widget="badge" optional="show"
                    decoration-info="picking_state == 'assigned'"
                    decoration-success="picking_state == 'done'"
                    decoration-warning="picking_state in ('waiting', 'confirmed')"
                    decoration-danger="picking_state == 'cancel'"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_settlement_form" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.form</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <form string="Consignment Settlement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Settlement" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-secondary" invisible="state != 'confirmed' or invoice_id"/>
                    <button name="action_create_commission_bill" type="object" string="Create Bill" class="btn-secondary" invisible="state != 'confirmed' or commission_bill_id or commission_amount == 0"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock_out" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_state" widget="statinfo" string="Stock Out"/>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_commission_bill" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not commission_bill_id">
                            <field name="commission_bill_count" widget="statinfo" string="Bills"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="period_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sold Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="allowed_uom_ids" column_invisible="1"/>
                                    <field name="available_qty" column_invisible="1"/>
                                    <field name="availability_state" widget="badge" readonly="1" optional="show" column_invisible="parent.state != 'draft'"
                                        decoration-success="availability_state == 'available'"
                                        decoration-danger="availability_state == 'not_available'"/>
                                    <field name="sold_qty"/>
                                    <field name="product_uom_id" widget="many2one_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="commission_rate" column_invisible="1"/>
                                    <field name="subtotal" readonly="1" optional="show"/>
                                    <field name="commission_amount" readonly="1" optional="hide"/>
                                    <field name="net_amount" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tha_consignment_settlement_search" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.search</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <search string="Consignment Settlements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_location_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="has_invoice" string="Has Invoice" domain="[('invoice_id', '!=', False)]"/>
                <filter name="no_invoice" string="To Invoice" domain="[('state', '=', 'confirmed'), ('invoice_id', '=', False)]"/>
                <filter name="has_bill" string="Has Bill" domain="[('commission_bill_id', '!=', False)]"/>
                <filter name="no_bill" string="To Bill" domain="[('state', '=', 'confirmed'), ('commission_amount', '>', 0), ('commission_bill_id', '=', False)]"/>
                <separator/>
                <filter name="period_from" string="Period From" date="period_from"/>
                <filter name="date_to" string="Period To" date="date_to"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_source_location" string="Source Location" context="{'group_by': 'source_location_id'}"/>
                    <filter name="group_period_from" string="Period From" context="{'group_by': 'period_from'}"/>
                    <filter name="group_period_to" string="Period To" context="{'group_by': 'date_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tha_consignment_settlement" model="ir.actions.act_window">
        <field name="name">Consignment Settlements</field>
        <field name="res_model">tha.consignment.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tha_consignment_settlement_list"/>
        <field name="search_view_id" ref="view_tha_consignment_settlement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a consignment settlement
            </p>
            <p>
                Consignment settlements are used to track sold products and calculate commissions.
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_settlement_list" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.list</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="currency_id" column_invisible="1"/>
                <field name="invoice_id" column_invisible="1"/>
                <field name="commission_bill_id" column_invisible="1"/>
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="settlement_date"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="team_id" optional="hide"/>
                <field name="amount_total" widget="monetary" optional="show"
                    decoration-info="state == 'confirmed' and not invoice_id"/>
                <field name="commission_amount" widget="monetary" optional="show"
                    decoration-info="state == 'confirmed' and commission_amount and not commission_bill_id"/>
                <field name="net_amount" widget="monetary" optional="show"
                    decoration-info="state == 'confirmed' and (not invoice_id or (commission_amount and not commission_bill_id))"/>
                <field name="delivery_status" widget="badge" optional="show"
                    decoration-info="delivery_status == 'assigned'"
                    decoration-success="delivery_status == 'done'"
                    decoration-warning="delivery_status in ('waiting', 'confirmed')"
                    decoration-danger="delivery_status == 'cancel'"/>
                <field name="invoice_status" widget="badge" optional="show"
                    decoration-success="invoice_status == 'invoiced'"
                    decoration-info="invoice_status == 'to invoice'"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_settlement_form" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.form</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <form string="Consignment Settlement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Settlement" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'confirmed' or invoice_id"/>
                    <button name="action_create_commission_bill" type="object" string="Create Bill" class="btn-primary" invisible="state != 'confirmed' or commission_amount == 0 or commission_bill_id"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not order_id">
                            <span class="o_stat_text">Consignment Order</span>
                        </button>
                        <button name="action_view_delivery" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <span class="o_stat_text">Delivery</span>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                        <button name="action_view_commission_bill" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not commission_bill_id">
                            <field name="commission_bill_count" widget="statinfo" string="Bill"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="order_id" readonly="1"/>
                            <field name="settlement_date" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="delivery_status" widget="badge" readonly="1"
                                decoration-info="delivery_status == 'assigned'"
                                decoration-success="delivery_status == 'done'"
                                decoration-warning="delivery_status in ('waiting', 'confirmed')"
                                decoration-danger="delivery_status == 'cancel'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Settlement Lines" name="settlement_lines">
                            <field name="line_ids"
                                   widget="section_and_note_one2many"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="display_type" force_save="1" column_invisible="True"/>
                                    <field name="allowed_uom_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="name" widget="section_and_note_text" invisible="not display_type"/>
                                    <field name="product_uom_qty" invisible="display_type"/>
                                    <field name="product_uom_id" widget="many2one_uom" required="not display_type" invisible="display_type"/>
                                    <field name="price_unit" invisible="display_type"/>
                                    <field name="subtotal" readonly="1" invisible="display_type"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                        <page string="Other Info" name="other_information">
                            <group>
                                <group string="Sales">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="team_id" options="{'no_create': True}"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                                <group string="Invoicing">
                                    <field name="partner_invoice_id"/>
                                    <field name="payment_term_id"/>
                                    <field name="fiscal_position_id"/>
                                    <field name="journal_id"/>
                                    <field name="invoice_status" widget="badge"
                                        decoration-success="invoice_status == 'invoiced'"
                                        decoration-info="invoice_status == 'to invoice'"/>
                                </group>
                                <group string="Delivery">
                                    <field name="warehouse_id" readonly="1"/>
                                    <field name="order_id" string="Source" readonly="1"/>
                                    <field name="effective_date" readonly="1"/>
                                    <field name="delivery_status" widget="badge" readonly="1"
                                        decoration-info="delivery_status == 'assigned'"
                                        decoration-success="delivery_status == 'done'"
                                        decoration-warning="delivery_status in ('waiting', 'confirmed')"
                                        decoration-danger="delivery_status == 'cancel'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tha_consignment_settlement_search" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.search</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <search string="Consignment Settlements">
                <field name="name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="has_invoice" string="Has Invoice" domain="[('invoice_id', '!=', False)]"/>
                <filter name="has_bill" string="Has Bill" domain="[('commission_bill_id', '!=', False)]"/>
                <separator/>
                <filter name="settlement_date" string="Settlement Date" date="settlement_date"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Settlement Date" context="{'group_by': 'settlement_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tha_consignment_settlement" model="ir.actions.act_window">
        <field name="name">Consignment Settlements</field>
        <field name="res_model">tha.consignment.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_tha_consignment_settlement_list"/>
        <field name="search_view_id" ref="view_tha_consignment_settlement_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No settlements yet
            </p>
            <p>
                Settlements are created from confirmed consignment orders.
            </p>
        </field>
    </record>
</odoo>

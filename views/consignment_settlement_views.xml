<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_settlement_list" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.list</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="period_from"/>
                <field name="date_to"/>
                <field name="source_location_id"/>
                <field name="amount_total"/>
                <field name="commission_amount"/>
                <field name="net_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_settlement_form" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.form</field>
        <field name="model">tha.consignment.settlement</field>
        <field name="arch" type="xml">
            <form string="Consignment Settlement">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Settlement" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock_out" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <span class="o_stat_text">Stock Out</span>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <span class="o_stat_text">Invoice</span>
                        </button>
                        <button name="action_view_commission_bill" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not commission_bill_id">
                            <span class="o_stat_text">Commission Bill</span>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="period_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sold Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="available_qty" readonly="1"/>
                                    <field name="sold_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="lot_id"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="commission_rate"/>
                                    <field name="commission_amount" readonly="1"/>
                                    <field name="net_amount" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tha_consignment_settlement" model="ir.actions.act_window">
        <field name="name">Consignment Settlements</field>
        <field name="res_model">tha.consignment.settlement</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tha_consignment_settlement_line_list" model="ir.ui.view">
        <field name="name">tha.consignment.settlement.line.list</field>
        <field name="model">tha.consignment.settlement.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="settlement_id"/>
                <field name="product_id"/>
                <field name="sold_qty"/>
                <field name="price_unit"/>
                <field name="subtotal"/>
                <field name="commission_amount"/>
                <field name="net_amount"/>
            </list>
        </field>
    </record>

    <record id="action_tha_consignment_sales_report" model="ir.actions.act_window">
        <field name="name">Consignment Sales</field>
        <field name="res_model">tha.consignment.settlement.line</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_tha_consignment_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">tha.consignment.settlement.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

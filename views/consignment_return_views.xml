<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_return_list" model="ir.ui.view">
        <field name="name">tha.consignment.return.list</field>
        <field name="model">tha.consignment.return</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date_return"/>
                <field name="partner_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="picking_state" widget="badge" decoration-success="picking_state == 'done'" decoration-warning="picking_state == 'waiting'"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_return_form" model="ir.ui.view">
        <field name="name">tha.consignment.return.form</field>
        <field name="model">tha.consignment.return</field>
        <field name="arch" type="xml">
            <form string="Consignment Return">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfer" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_state" widget="statinfo" string="Transfer"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date_return" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                            <field name="destination_warehouse_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="available_product_ids" invisible="1"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tha_consignment_return_search" model="ir.ui.view">
        <field name="name">tha.consignment.return.search</field>
        <field name="model">tha.consignment.return</field>
        <field name="arch" type="xml">
            <search string="Consignment Returns">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="transfer_done" string="Transfer Done" domain="[('picking_state', '=', 'done')]"/>
                <filter name="transfer_pending" string="Transfer Pending" domain="[('picking_state', 'not in', ['done', 'cancel'])]"/>
                <separator/>
                <filter name="date_return" string="Return Date" date="date_return"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_transfer_status" string="Transfer Status" context="{'group_by': 'picking_state'}"/>
                    <filter name="group_source_location" string="Source Location" context="{'group_by': 'source_location_id'}"/>
                    <filter name="group_destination_location" string="Destination Location" context="{'group_by': 'destination_location_id'}"/>
                    <filter name="group_date" string="Return Date" context="{'group_by': 'date_return'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tha_consignment_return" model="ir.actions.act_window">
        <field name="name">Consignment Returns</field>
        <field name="res_model">tha.consignment.return</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tha_consignment_return_search"/>
    </record>
</odoo>

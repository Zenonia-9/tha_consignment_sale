<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_order_list" model="ir.ui.view">
        <field name="name">tha.consignment.order.list</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="source_location_id" optional="show"/>
                <field name="destination_location_id" optional="show"/>
                <field name="amount_total"/>
                <field name="picking_state" widget="badge"
                    decoration-info="picking_state == 'assigned'"
                    decoration-success="picking_state == 'done'"
                    decoration-warning="picking_state in ('waiting', 'confirmed')"
                    decoration-danger="picking_state == 'cancel'"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_order_form" model="ir.ui.view">
        <field name="name">tha.consignment.order.form</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <form string="Consignment Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfer" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_state" widget="statinfo" string="Transfer"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Locations">
                        <group>
                            <field name="source_warehouse_id" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="destination_warehouse_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="allowed_uom_ids" column_invisible="1"/>
                                    <field name="product_uom_id" widget="many2one_uom"/>
                                    <field name="consignment_price_unit"/>
                                    <field name="consignment_discount" optional="hide"/>
                                    <field name="commission_rate" optional="show"/>
                                    <field name="consignment_subtotal" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tha_consignment_order_search" model="ir.ui.view">
        <field name="name">tha.consignment.order.search</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <search string="Consignment Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="transfer_done" string="Transfer Done" domain="[('picking_state', '=', 'done')]"/>
                <filter name="transfer_pending" string="Transfer Pending" domain="[('picking_state', 'not in', ['done', 'cancel'])]"/>
                <separator/>
                <filter name="date_order" string="Order Date" date="date_order"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_transfer_status" string="Transfer Status" context="{'group_by': 'picking_state'}"/>
                    <filter name="group_source_location" string="Source Location" context="{'group_by': 'source_location_id'}"/>
                    <filter name="group_destination_location" string="Destination Location" context="{'group_by': 'destination_location_id'}"/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tha_consignment_order" model="ir.actions.act_window">
        <field name="name">Consignment Orders</field>
        <field name="res_model">tha.consignment.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tha_consignment_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a consignment order
            </p>
            <p>
                Consignment orders are used to transfer stock to shops and track transfer status.
            </p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_order_list" model="ir.ui.view">
        <field name="name">tha.consignment.order.list</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="amount_total"/>
                <field name="picking_state"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_order_form" model="ir.ui.view">
        <field name="name">tha.consignment.order.form</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <form string="Consignment Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfer" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_state" widget="statinfo" string="Transfer"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Locations">
                        <group>
                            <field name="source_warehouse_id" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="destination_warehouse_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="consignment_price_unit"/>
                                    <field name="consignment_discount"/>
                                    <field name="commission_rate"/>
                                    <field name="consignment_subtotal" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tha_consignment_order" model="ir.actions.act_window">
        <field name="name">Consignment Orders</field>
        <field name="res_model">tha.consignment.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

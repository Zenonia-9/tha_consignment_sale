<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tha_consignment_order_list" model="ir.ui.view">
        <field name="name">tha.consignment.order.list</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-info="state == 'draft'">
                <header>
                    <button name="action_open_print_wizard" type="object" string="Print"/>
                </header>
                <field name="name"/>
                <field name="date_order"/>
                <field name="commitment_date" optional="show"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="team_id" optional="hide"/>
                <field name="amount_total"/>
                <field name="transfer_state" widget="badge"
                    decoration-info="transfer_state == 'assigned'"
                    decoration-success="transfer_state == 'done'"
                    decoration-warning="transfer_state in ('waiting', 'confirmed', 'partially_done')"
                    decoration-danger="transfer_state == 'cancel'"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_tha_consignment_order_form" model="ir.ui.view">
        <field name="name">tha.consignment.order.form</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <form string="Consignment Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_settle_wizard" type="object" string="Settle" class="btn-primary" invisible="not can_settle"/>
                    <button name="action_open_print_wizard" type="object" string="Print" invisible="state == 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transfer" type="object" class="oe_stat_button" icon="fa-truck" invisible="not transfer_count">
                            <field name="transfer_count" widget="statinfo" string="Delivery"/>
                        </button>
                        <button name="action_view_returns" type="object" class="oe_stat_button" icon="fa-reply" invisible="not return_count">
                            <field name="return_count" widget="statinfo" string="Returns"/>
                        </button>
                        <button name="action_view_settlements" type="object" class="oe_stat_button" icon="fa-files-o" invisible="not settlement_count">
                            <field name="settlement_count" widget="statinfo" string="Settlements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group name="order_header">
                        <group>
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   context="{'show_address': 1, 'show_vat': True}"
                                   placeholder="Type to find a customer..."
                                   readonly="state != 'draft'"/>
                            <field name="source_warehouse_id" readonly="state != 'draft'"/>
                            <field name="source_location_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="commitment_date" readonly="state != 'draft'"/>
                            <field name="pricelist_id" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="commission_rate" readonly="state != 'draft'"/>
                            <field name="destination_warehouse_id" readonly="state != 'draft'"/>
                            <field name="destination_location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="line_ids"
                                   widget="section_and_note_one2many"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <control>
                                        <create name="add_product_control" string="Add a product"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="display_type" force_save="1" column_invisible="True"/>
                                    <field name="allowed_uom_ids" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="name" widget="section_and_note_text" invisible="not display_type"/>
                                    <field name="product_uom_qty" invisible="display_type"/>
                                    <field name="qty_delivered" readonly="1" invisible="display_type"/>
                                    <field name="qty_invoiced" readonly="1" invisible="display_type"/>
                                    <field name="qty_returned" readonly="1" invisible="display_type"/>
                                    <field name="qty_settled" readonly="1" invisible="display_type"/>
                                    <field name="product_uom_id" widget="many2one_uom" required="not display_type" invisible="display_type"/>
                                    <field name="consignment_price_unit" invisible="display_type"/>
                                    <field name="consignment_subtotal" readonly="1" invisible="display_type"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" colspan="2">
                                <field name="amount_total" readonly="1"/>
                                <field name="commission_amount" readonly="1"/>
                                <field name="net_amount" readonly="1"/>
                            </group>
                        </page>
                        <page string="Other Info" name="other_information">
                            <group>
                                <group string="Sales">
                                    <field name="user_id" widget="many2one_avatar_user" readonly="state == 'cancel'"/>
                                    <field name="team_id" readonly="state == 'cancel'" options="{'no_create': True}"/>
                                    <field name="company_id" readonly="state == 'cancel'" groups="base.group_multi_company"/>
                                </group>
                                <group string="Delivery">
                                    <field name="transfer_state" readonly="1" widget="badge"
                                        decoration-info="transfer_state == 'assigned'"
                                        decoration-success="transfer_state == 'done'"
                                        decoration-warning="transfer_state in ('waiting', 'confirmed', 'partially_done')"
                                        decoration-danger="transfer_state == 'cancel'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tha_consignment_order_search" model="ir.ui.view">
        <field name="name">tha.consignment.order.search</field>
        <field name="model">tha.consignment.order</field>
        <field name="arch" type="xml">
            <search string="Consignment Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="delivery_done" string="Delivery Done" domain="[('transfer_state', '=', 'done')]"/>
                <filter name="delivery_pending" string="Delivery Pending" domain="[('transfer_state', 'not in', ['done', 'cancel', 'no_transfer'])]"/>
                <separator/>
                <filter name="date_order" string="Order Date" date="date_order"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_delivery_status" string="Delivery Status" context="{'group_by': 'transfer_state'}"/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'date_order'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tha_consignment_order" model="ir.actions.act_window">
        <field name="name">Consignment Orders</field>
        <field name="res_model">tha.consignment.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tha_consignment_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a consignment order
            </p>
            <p>
                Consignment orders control deliveries, returns, and settlements from one document.
            </p>
        </field>
    </record>
</odoo>

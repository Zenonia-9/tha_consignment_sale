<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tha_consignment_transfer" model="ir.actions.act_window">
        <field name="name">Consignment Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">["|", ("tha_is_consignment_transfer", "=", True), ("tha_consignment_order_id", "!=", False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No consignment transfers yet
            </p>
            <p>
                Consignment transfers are created automatically from consignment orders and settlements.
            </p>
        </field>
    </record>

</odoo>

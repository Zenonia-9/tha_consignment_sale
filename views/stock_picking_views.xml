<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tha_consignment_transfer" model="ir.actions.act_window">
        <field name="name">Consignment Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("tha_is_consignment_transfer", "=", True)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_tha_consignment_stock_quant_list" model="ir.ui.view">
        <field name="name">tha.consignment.stock.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="reserved_quantity"/>
                <field name="available_quantity"/>
            </list>
        </field>
    </record>

    <record id="action_tha_consignment_stock_by_shop" model="ir.actions.act_window">
        <field name="name">Consignment Stock by Shop</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <!-- <field name="view_id" ref="view_tha_consignment_stock_quant_list"/> -->
        <field name="domain">[("location_id.tha_is_consignment_location", "=", True)]</field>
        <field name="context">{'group_by': ['location_id', 'product_id'], 'create': False}</field>
    </record>
</odoo>

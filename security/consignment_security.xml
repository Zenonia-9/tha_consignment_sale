<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_tha_consignment_order_multi_company" model="ir.rule">
        <field name="name">Consignment Order multi-company</field>
        <field name="model_id" ref="model_tha_consignment_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="rule_tha_consignment_order_line_multi_company" model="ir.rule">
        <field name="name">Consignment Order Line multi-company</field>

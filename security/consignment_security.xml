        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="rule_tha_consignment_settlement_multi_company" model="ir.rule">
        <field name="name">Consignment Settlement multi-company</field>
        <field name="model_id" ref="model_tha_consignment_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="rule_tha_consignment_settlement_line_multi_company" model="ir.rule">
        <field name="name">Consignment Settlement Line multi-company</field>
        <field name="model_id" ref="model_tha_consignment_settlement_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>

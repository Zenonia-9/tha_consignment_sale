<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_consignment_order_a4" model="ir.actions.report">
        <field name="name">Consignment Order</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document</field>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a4"/>
    </record>

    <record id="action_report_consignment_order_a5" model="ir.actions.report">
        <field name="name">Consignment Order A5</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a5"/>
    </record>

    <template id="report_consignment_order_body">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

        <t t-set="letterhead" t-value="o.env.ref('tha_consignment_sale.attachment_ytk_consignment_header', raise_if_not_found=False)"/>
        <t t-if="not letterhead">
            <t t-set="letterhead"
               t-value="o.env['ir.attachment'].sudo().search([
                    ('name', 'in', ['invoice_letterhead.png', 'consignment_order_letterhead.png', 'ytk_consignment_header.png']),
                    ('mimetype', 'ilike', 'image')
               ], order='id desc', limit=1)"/>
        </t>

        <t t-set="lines" t-value="o.line_ids.filtered(lambda line: not line.display_type)"/>

        <t t-call="web.basic_layout">
            <div class="page" t-att-style="'position: relative; font-size: %s; height: %s; min-height: %s; padding-bottom: 0; overflow: hidden;' % (font_size, page_height, page_height)">
                <t t-if="letterhead and letterhead.datas">
                    <img t-att-src="image_data_uri(letterhead.datas)"
                         style="
                            position: absolute;
                            top: 0;
                            left: 0;
                            width: 100%;
                            height: auto;
                            z-index: 0;
                         "
                         alt="YTK Header"/>
                </t>

                <div t-att-style="'position: relative; z-index: 1; padding-top: %s;' % content_top_padding">
                    <div style="margin-bottom: 18px;">
                        <h3 style="margin: 0; font-weight: bold;">
                            Consignment Order
                        </h3>
                    </div>

                    <table t-attf-style="width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: #{font_size};">
                        <tr>
                            <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                                <strong>Customer Name:</strong>
                                <span t-field="o.partner_id.name"/><br/>

                                <strong>Address:</strong>
                                <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                <br t-if="o.partner_id.street"/>

                                <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/>
                                <br t-if="o.partner_id.street2"/>

                                <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>
                                <span t-if="o.partner_id.state_id">
                                    , <span t-field="o.partner_id.state_id.name"/>
                                </span>
                                <span t-if="o.partner_id.country_id">
                                    , <span t-field="o.partner_id.country_id.name"/>
                                </span>
                                <br t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.country_id"/>

                                <span t-if="o.partner_id.phone">
                                    <strong>Phone:</strong>
                                    <span t-field="o.partner_id.phone"/>
                                </span>
                            </td>

                            <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                                <strong>Order No:</strong>
                                <span t-field="o.name"/><br/>

                                <strong>Order Date:</strong>
                                <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/><br/>

                                <strong>Delivery Date:</strong>
                                <span t-if="o.commitment_date" t-field="o.commitment_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/><br/>

                                <strong>Salesperson:</strong>
                                <span t-if="'user_id' in o._fields and o.user_id" t-field="o.user_id.name"/><br/>

                                <strong>Commission %:</strong>
                                <span t-if="'commission_rate' in o._fields" t-esc="'%.2f' % (o.commission_rate or 0.0)"/>
                            </td>
                        </tr>
                    </table>

                    <table t-attf-style="width: 100%; border-collapse: collapse; font-size: #{font_size};">
                        <thead>
                            <tr>
                                <th style="border: 1px solid #000; padding: 6px; width: 5%; text-align: center;">No.</th>
                                <th style="border: 1px solid #000; padding: 6px; width: 43%; text-align: center;">Product</th>
                                <th style="border: 1px solid #000; padding: 6px; width: 10%; text-align: center;">Qty</th>
                                <th style="border: 1px solid #000; padding: 6px; width: 10%; text-align: center;">UOM</th>
                                <th style="border: 1px solid #000; padding: 6px; width: 16%; text-align: center;">Unit Price</th>
                                <th style="border: 1px solid #000; padding: 6px; width: 16%; text-align: center;">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="counter" t-value="0"/>

                            <t t-foreach="lines" t-as="line">
                                <t t-set="counter" t-value="counter + 1"/>

                                <tr>
                                    <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                        <span t-esc="counter"/>
                                    </td>

                                    <td style="border: 1px solid #000; padding: 6px;">
                                        <span t-if="line.product_id" t-field="line.product_id.display_name"/>
                                        <span t-if="not line.product_id and line.name" t-field="line.name"/>
                                    </td>

                                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                        <span t-esc="line.product_uom_qty" t-options="{'widget': 'float', 'precision': 0}"/>
                                    </td>

                                    <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                        <span t-if="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                    </td>

                                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                        <span t-field="line.consignment_price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>

                                    <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                        <span t-field="line.consignment_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table t-attf-style="width: 40%; margin-left: auto; border-collapse: collapse; margin-top: 18px; font-size: #{font_size};">
                        <tr>
                            <td style="border: 1px solid #000; padding: 6px;">
                                <strong>Sub Total</strong>
                            </td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>

                        <tr t-if="'commission_amount' in o._fields">
                            <td style="border: 1px solid #000; padding: 6px;">
                                <strong>Commission Amount</strong>
                            </td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                <span t-field="o.commission_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="border: 1px solid #000; padding: 6px;">
                                <strong>Total Amount</strong>
                            </td>
                            <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                <strong>
                                    <t t-if="'net_amount' in o._fields">
                                        <span t-field="o.net_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </t>
                                </strong>
                            </td>
                        </tr>
                    </table>
                </div>

                <div t-attf-style="position:absolute; left:0; right:0; bottom:#{signature_bottom}; width:100%; z-index:2; page-break-inside:avoid;">
                    <table t-attf-style="width:100%; text-align:center; border-collapse:collapse; font-size:#{font_size};">
                        <tr>
                            <td style="width:33%; vertical-align:top; border:none;">
                                <strong>Delivery by:</strong>
                                <div style="margin-top:45px;">Sign ........................................</div>
                                <div style="margin-top:15px;">Name ........................................</div>
                            </td>

                            <td style="width:33%; vertical-align:top; border:none;">
                                <strong>Goods received by:</strong>
                                <div style="margin-top:45px;">Sign ........................................</div>
                                <div style="margin-top:15px;">Name ........................................</div>
                            </td>

                            <td style="width:33%; vertical-align:top; border:none;">
                                <strong>Cash received by:</strong>
                                <div style="margin-top:45px;">Sign ........................................</div>
                                <div style="margin-top:15px;">Name ........................................</div>
                            </td>
                        </tr>
                    </table>
                </div>

                <div style="position:absolute; left:0; right:0; bottom:0mm; width:100%; z-index:2; text-align:center; font-size:12px; color:#333; page-break-inside:avoid;">
                    <div style="border-top:1px dotted #000; width:100%; height:1px; margin:0 0 6px 0;"></div>
                    <div><strong>YGN Office</strong></div>
                    <div>Ph: 09 765488330, 09 765488331</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_consignment_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tha_consignment_sale.report_consignment_order_body">
                    <t t-set="font_size" t-value="'13px'"/>
                    <t t-set="page_height" t-value="'340mm'"/>
                    <t t-set="content_top_padding" t-value="'155px'"/>
                    <t t-set="signature_bottom" t-value="'30mm'"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_consignment_order_document_a5">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tha_consignment_sale.report_consignment_order_body">
                    <t t-set="font_size" t-value="'9px'"/>
                    <t t-set="page_height" t-value="'235mm'"/>
                    <t t-set="content_top_padding" t-value="'105px'"/>
                    <t t-set="signature_bottom" t-value="'23mm'"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
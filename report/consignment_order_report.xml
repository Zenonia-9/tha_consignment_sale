<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_consignment_order_a4" model="ir.actions.report">
        <field name="name">Consignment Order</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a4"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_consignment_order_a5" model="ir.actions.report">
        <field name="name">Consignment Order A5</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a5"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_consignment_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lines" t-value="o.line_ids.filtered(lambda line: not line.display_type)"/>
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <t t-call="tha_consignment_sale.consignment_order_layout_a4">
                    <div class="page">
                        <style>
                            .consignment-order-page {
                                font-size: 13px;
                            }

                            .consignment-order-page .info-label {
                                font-weight: 600;
                                white-space: nowrap;
                            }

                            .consignment-order-page .line-table {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: separate;
                                border-spacing: 0;
                            }

                            .consignment-order-page .line-table th,
                            .consignment-order-page .line-table td {
                                border: 1px solid #222;
                                padding: 4px 5px;
                                vertical-align: middle;
                            }

                            .consignment-order-page .line-table th {
                                text-align: center;
                                font-weight: 600;
                            }

                            .consignment-order-page .line-table .no-cell {
                                width: 8mm;
                                text-align: center;
                                vertical-align: middle;
                                white-space: nowrap;
                            }

                            .consignment-order-page .line-table .text-cell {
                                vertical-align: top;
                                word-break: normal;
                                overflow-wrap: break-word;
                            }

                            .consignment-order-page .amount-cell {
                                padding-right: 5px !important;
                                white-space: nowrap;
                            }
                        </style>

                        <div class="consignment-order-page">
                            <div class="text-center mb-3">
                                <h3 style="margin-bottom: 0;">Consignment Order</h3>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Order No.</div>
                                        <div class="col-7">: <span t-field="o.name"/></div>
                                    </div>
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Shop Name</div>
                                        <div class="col-7">: <span t-field="o.partner_id.name"/></div>
                                    </div>
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Order Date</div>
                                        <div class="col-7">:
                                            <span t-field="o.date_order"
                                                t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Currency</div>
                                        <div class="col-7">: <span t-field="o.currency_id.name"/></div>
                                    </div>
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Commission %</div>
                                        <div class="col-7">: <span t-esc="'%.2f' % (o.commission_rate or 0.0)"/>%</div>
                                    </div>
                                    <div class="row mb-1">
                                        <div class="col-5 info-label">Source</div>
                                        <div class="col-7">: <span t-field="o.source_location_id.display_name"/></div>
                                    </div>
                                </div>
                            </div>

                            <table class="line-table">
                                <thead>
                                    <tr>
                                        <th class="no-cell">No</th>
                                        <th style="width: 20%;">Product</th>
                                        <th style="width: 24%;">Description</th>
                                        <th style="width: 9%;" class="text-end">Qty</th>
                                        <th style="width: 9%;">UoM</th>
                                        <th style="width: 14%;" class="text-end">Unit Price</th>
                                        <th style="width: 7%;" class="text-end">Disc %</th>
                                        <!-- <th style="width: 8%;" class="text-end">Comm %</th> -->
                                        <th style="width: 16%; padding-right: 5px;" class="text-end">Subtotal</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr t-foreach="lines" t-as="line">
                                        <td class="no-cell">
                                            <span t-esc="line_index + 1"/>
                                        </td>
                                        <td class="text-cell">
                                            <span t-field="line.product_id.display_name"/>
                                        </td>
                                        <td class="text-cell">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td>
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <span t-field="line.consignment_price_unit"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <span t-esc="'%.2f' % (line.consignment_discount or 0.0)"/>
                                        </td>
                                        <!-- <td class="text-end amount-cell">
                                            <span t-esc="'%.2f' % (line.commission_rate or 0.0)"/>
                                        </td> -->
                                        <td class="text-end amount-cell">
                                            <span t-field="line.consignment_subtotal"
                                                t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <td colspan="5" style="border: none; !important"></td>
                                        <td colspan="2" class="text-end">
                                            <strong>Total Amount</strong>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <strong>
                                                <span t-field="o.amount_total"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" style="border: none; !important"></td>
                                        <td colspan="2" class="text-end">
                                            <strong>Commission Amount</strong>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <strong>
                                                <span t-field="o.commission_amount"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="5" style="border: none; !important"></td>
                                        <td colspan="2" class="text-end">
                                            <strong>Net Amount</strong>
                                        </td>
                                        <td class="text-end amount-cell">
                                            <strong>
                                                <span t-field="o.net_amount"
                                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- SIGNATURE -->
                            <div class="mt-4" style="page-break-inside: avoid;">

                                <div class="row text-center">
                                    <div class="col-4"><strong>Approved By</strong></div>
                                    <div class="col-4"><strong>Received By</strong></div>
                                    <div class="col-4"><strong>Paid By</strong></div>
                                </div>

                                <div class="row mt-3">
                                    <t t-foreach="[1,2,3]" t-as="x">
                                        <div class="col-4 px-3">
                                            <div style="border-bottom: 1px dotted black; height: 12px;"/>
                                        </div>
                                    </t>
                                </div>

                                <div class="row mt-3">
                                    <t t-foreach="[1,2,3]" t-as="x">
                                        <div class="col-4 px-3">
                                            <div style="border-bottom: 1px dotted black; height: 12px;"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>


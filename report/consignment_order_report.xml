<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_consignment_order_a4" model="ir.actions.report">
        <field name="name">Consignment Order</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a4"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_consignment_order_a5" model="ir.actions.report">
        <field name="name">Consignment Order A5</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a5"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="consignment_order_report_body">
        <t t-set="lines" t-value="o.line_ids.filtered(lambda line: not line.display_type)"/>
        <t t-set="address_parts" t-value="[part for part in [o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name if o.partner_id.state_id else False, o.partner_id.country_id.name if o.partner_id.country_id else False] if part]"/>

        <div t-attf-class="ytk-consignment-page #{page_class or ''}"
             t-att-style="'position: relative; font-size: %s; min-height: %s; padding-top: %s; padding-bottom: %s; color: #111;' % (font_size, page_height, top_padding, bottom_padding)">
            <style>
                .ytk-consignment-page .ytk-title {
                    text-align: center;
                    font-weight: 700;
                    margin: 0 0 14px 0;
                }

                .ytk-consignment-page .ytk-info-table,
                .ytk-consignment-page .ytk-line-table,
                .ytk-consignment-page .ytk-total-table,
                .ytk-consignment-page .ytk-sign-table {
                    width: 100%;
                    border-collapse: collapse;
                }

                .ytk-consignment-page .ytk-info-table td {
                    padding: 2px 4px;
                    vertical-align: top;
                }

                .ytk-consignment-page .ytk-label {
                    font-weight: 700;
                    white-space: nowrap;
                }

                .ytk-consignment-page .ytk-line-table th,
                .ytk-consignment-page .ytk-line-table td {
                    border: 1px solid #000;
                    padding: 5px 6px;
                    vertical-align: top;
                }

                .ytk-consignment-page .ytk-line-table th {
                    text-align: center;
                    font-weight: 700;
                }

                .ytk-consignment-page .ytk-center {
                    text-align: center;
                }

                .ytk-consignment-page .ytk-right {
                    text-align: right;
                    white-space: nowrap;
                }

                .ytk-consignment-page .ytk-total-table td {
                    padding: 3px 6px;
                }

                .ytk-consignment-page .ytk-total-label {
                    font-weight: 700;
                    text-align: right;
                    white-space: nowrap;
                }

                .ytk-consignment-page .ytk-sign-table td {
                    width: 25%;
                    text-align: center;
                    vertical-align: top;
                    padding: 0 8px;
                }
            </style>

            <h3 class="ytk-title">Consignment Order</h3>

            <table class="ytk-info-table" style="margin-bottom: 12px;">
                <tr>
                    <td style="width: 18%;"><span class="ytk-label">Customer Name</span></td>
                    <td style="width: 32%;">: <span t-field="o.partner_id.name"/></td>
                    <td style="width: 18%;"><span class="ytk-label">Order No.</span></td>
                    <td style="width: 32%;">: <span t-field="o.name"/></td>
                </tr>
                <tr>
                    <td><span class="ytk-label">Address</span></td>
                    <td>: <span t-esc="', '.join(address_parts) if address_parts else ''"/></td>
                    <td><span class="ytk-label">Order Date</span></td>
                    <td>: <span t-field="o.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/></td>
                </tr>
                <tr>
                    <td><span class="ytk-label">Phone</span></td>
                    <td>: <span t-field="o.partner_id.phone"/></td>
                    <td><span class="ytk-label">Delivery Date</span></td>
                    <td>: <span t-if="o.commitment_date" t-field="o.commitment_date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/></td>
                </tr>
                <tr>
                    <td/>
                    <td/>
                    <td><span class="ytk-label">Commission %</span></td>
                    <td>: <span t-esc="'%.2f' % (o.commission_rate or 0.0)"/></td>
                </tr>
            </table>

            <table class="ytk-line-table">
                <thead>
                    <tr>
                        <th style="width: 8%;">No.</th>
                        <th style="width: 38%;">Product</th>
                        <th style="width: 12%;">Qty</th>
                        <th style="width: 12%;">UOM</th>
                        <th style="width: 15%;">Unit Price</th>
                        <th style="width: 15%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="line">
                        <td class="ytk-center">
                            <span t-esc="line_index + 1"/>
                        </td>
                        <td>
                            <span t-field="line.product_id.display_name"/>
                        </td>
                        <td class="ytk-right">
                            <span t-field="line.product_uom_qty"/>
                        </td>
                        <td class="ytk-center">
                            <span t-field="line.product_uom_id.name"/>
                        </td>
                        <td class="ytk-right">
                            <span t-field="line.consignment_price_unit"
                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                        <td class="ytk-right">
                            <span t-field="line.consignment_subtotal"
                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <table class="ytk-total-table" style="margin-top: 10px; margin-left: auto; width: 42%;">
                <tr>
                    <td class="ytk-total-label">Total Amount</td>
                    <td class="ytk-right">
                        <span t-field="o.amount_total"
                              t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="ytk-total-label">Commission Amount</td>
                    <td class="ytk-right">
                        <span t-field="o.commission_amount"
                              t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </td>
                </tr>
                <tr>
                    <td class="ytk-total-label">Net Amount</td>
                    <td class="ytk-right">
                        <span t-field="o.net_amount"
                              t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                    </td>
                </tr>
            </table>

            <div style="margin-top: 42px; page-break-inside: avoid;">
                <table class="ytk-sign-table">
                    <tr>
                        <td><strong>Sales Person</strong></td>
                        <td><strong>Checked By</strong></td>
                        <td><strong>Received By</strong></td>
                        <td><strong>Delivered By</strong></td>
                    </tr>
                    <tr>
                        <td style="padding-top: 56px;">
                            <div style="border-bottom: 1px dotted #000; height: 1px; margin-bottom: 6px;"/>
                            <div t-if="o.user_id"><span t-field="o.user_id.name"/></div>
                        </td>
                        <td style="padding-top: 56px;">
                            <div style="border-bottom: 1px dotted #000; height: 1px; margin-bottom: 6px;"/>
                        </td>
                        <td style="padding-top: 56px;">
                            <div style="border-bottom: 1px dotted #000; height: 1px; margin-bottom: 6px;"/>
                        </td>
                        <td style="padding-top: 56px;">
                            <div style="border-bottom: 1px dotted #000; height: 1px; margin-bottom: 6px;"/>
                        </td>
                    </tr>
                </table>
            </div>

            <div style="position:absolute; left:0; right:0; bottom:0mm; width:100%; z-index:2; text-align:center; font-size:12px; color:#333; page-break-inside:avoid;">
                <div style="border-top:1px dotted #000; width:100%; height:1px; margin:0 0 6px 0;"></div>
                <div><strong>YGN Office</strong></div>
                <div>Ph: 09 765488330, 09 765488331</div>
            </div>
        </div>
    </template>

    <template id="report_consignment_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <t t-call="tha_consignment_sale.consignment_order_layout_a4">
                    <div class="page">
                        <t t-call="tha_consignment_sale.consignment_order_report_body">
                            <t t-set="font_size" t-value="'13px'"/>
                            <t t-set="top_padding" t-value="'120px'"/>
                            <t t-set="bottom_padding" t-value="'58px'"/>
                            <t t-set="page_height" t-value="'260mm'"/>
                            <t t-set="page_class" t-value="'ytk-consignment-a4'"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_consignment_order_document_a5">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <t t-call="tha_consignment_sale.consignment_order_layout_a5">
                    <div class="page">
                        <t t-call="tha_consignment_sale.consignment_order_report_body">
                            <t t-set="font_size" t-value="'11px'"/>
                            <t t-set="top_padding" t-value="'95px'"/>
                            <t t-set="bottom_padding" t-value="'48px'"/>
                            <t t-set="page_height" t-value="'175mm'"/>
                            <t t-set="page_class" t-value="'ytk-consignment-a5'"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

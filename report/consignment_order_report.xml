<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_consignment_order_a4" model="ir.actions.report">
        <field name="name">Consignment Order</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a4"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_consignment_order_a5" model="ir.actions.report">
        <field name="name">Consignment Order A5</field>
        <field name="model">tha.consignment.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="report_file">tha_consignment_sale.report_consignment_order_document_a5</field>
        <field name="paperformat_id" ref="tha_consignment_sale.paperformat_consignment_order_a5"/>
        <field name="print_report_name">'Consignment Order - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="consignment_order_report_body">
        <t t-set="lines" t-value="o.line_ids.filtered(lambda line: not line.display_type)"/>
        <t t-set="address_parts" t-value="[part for part in [o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name if o.partner_id.state_id else False, o.partner_id.country_id.name if o.partner_id.country_id else False] if part]"/>
        <t t-set="header_attachment" t-value="o.env.ref('tha_consignment_sale.attachment_ytk_consignment_header', raise_if_not_found=False)"/>

        <div class="page" t-att-style="'position: relative; font-size: %s; height: %s; min-height: %s; padding-bottom: 0; overflow: hidden;' % (font_size, page_height, page_height)">
            <t t-if="header_attachment and header_attachment.datas">
                <img t-att-src="image_data_uri(header_attachment.datas)"
                     style="position:absolute; top:0; left:0; width:100%; height:auto; z-index:0;"
                     alt="YTK Header"/>
            </t>

            <div t-att-style="'position: relative; z-index: 1; padding-top: %s;' % top_padding">
                <div style="margin-bottom: 18px;">
                    <h3 style="margin: 0; font-weight: bold;">Consignment Order</h3>
                </div>

                <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;" t-attf-style="font-size: #{font_size};">
                    <tr>
                        <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                            <strong>Customer Name:</strong>
                            <span t-field="o.partner_id.name"/><br/>

                            <strong>Address:</strong>
                            <span t-esc="', '.join(address_parts) if address_parts else ''"/>
                            <br/>

                            <span t-if="o.partner_id.phone">
                                <strong>Phone:</strong>
                                <span t-field="o.partner_id.phone"/>
                            </span>
                        </td>

                        <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                            <strong>Order No:</strong>
                            <span t-field="o.name"/><br/>

                            <strong>Order Date:</strong>
                            <span t-field="o.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/><br/>

                            <t t-if="o.commitment_date">
                                <strong>Delivery Date:</strong>
                                <span t-field="o.commitment_date" t-options="{&quot;widget&quot;: &quot;date&quot;, &quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/>
                                <br/>
                            </t>

                            <strong>Commission %:</strong>
                            <span t-esc="'%.2f' % (o.commission_rate or 0.0)"/>
                        </td>
                    </tr>
                </table>

                <table style="width: 100%; border-collapse: collapse;" t-attf-style="font-size: #{font_size};">
                    <thead>
                        <tr>
                            <th style="border: 1px solid #000; padding: 6px; width: 5%; text-align: center;">No.</th>
                            <th style="border: 1px solid #000; padding: 6px; width: 39%; text-align: center;">Product</th>
                            <th style="border: 1px solid #000; padding: 6px; width: 10%; text-align: center;">Qty</th>
                            <th style="border: 1px solid #000; padding: 6px; width: 10%; text-align: center;">UOM</th>
                            <th style="border: 1px solid #000; padding: 6px; width: 16%; text-align: center;">Unit Price</th>
                            <th style="border: 1px solid #000; padding: 6px; width: 20%; text-align: center;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="counter" t-value="0"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="counter" t-value="counter + 1"/>
                            <tr>
                                <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                    <span t-esc="counter"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 6px;">
                                    <span t-field="line.product_id.display_name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                    <span t-field="line.product_uom_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                    <span t-field="line.consignment_price_unit"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                                    <span t-field="line.consignment_subtotal"
                                          t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <table t-attf-style="width: 40%; margin-left: auto; border-collapse: collapse; margin-top: 18px; font-size: #{font_size};">
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px;">
                            <strong>Total Amount</strong>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                            <span t-field="o.amount_total"
                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px;">
                            <strong>Commission Amount</strong>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                            <span t-field="o.commission_amount"
                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px;">
                            <strong>Net Amount</strong>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right;">
                            <strong>
                                <span t-field="o.net_amount"
                                      t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </strong>
                        </td>
                    </tr>
                </table>
            </div>

            <div t-attf-style="position:absolute; left:0; right:0; bottom:#{sign_bottom}; width:100%; z-index:2; page-break-inside:avoid;">
                <table t-attf-style="width:100%; text-align:center; border-collapse:collapse; font-size:#{font_size};">
                    <tr>
                        <td style="width:25%; vertical-align:top; border:1px solid #000; padding:6px 8px 10px 8px;">
                            <strong>Sales Person</strong>
                            <div style="margin-top:45px;">Sign ........................................</div>
                            <div style="margin-top:15px;">
                                Name
                                <t t-if="o.user_id">
                                    <span t-esc="' %s' % o.user_id.name"/>
                                </t>
                                <t t-else=""> ........................................</t>
                            </div>
                        </td>
                        <td style="width:25%; vertical-align:top; border:1px solid #000; padding:6px 8px 10px 8px;">
                            <strong>Checked By</strong>
                            <div style="margin-top:45px;">Sign ........................................</div>
                            <div style="margin-top:15px;">Name ........................................</div>
                        </td>
                        <td style="width:25%; vertical-align:top; border:1px solid #000; padding:6px 8px 10px 8px;">
                            <strong>Received By</strong>
                            <div style="margin-top:45px;">Sign ........................................</div>
                            <div style="margin-top:15px;">Name ........................................</div>
                        </td>
                        <td style="width:25%; vertical-align:top; border:1px solid #000; padding:6px 8px 10px 8px;">
                            <strong>Delivered By</strong>
                            <div style="margin-top:45px;">Sign ........................................</div>
                            <div style="margin-top:15px;">Name ........................................</div>
                        </td>
                    </tr>
                </table>
            </div>

            <div style="position:absolute; left:0; right:0; bottom:0mm; width:100%; z-index:2; text-align:center; font-size:12px; color:#333; page-break-inside:avoid;">
                <div style="border-top:1px dotted #000; width:100%; height:1px; margin:0 0 6px 0;"></div>
                <div><strong>YGN Office</strong></div>
                <div>Ph: 09 765488330, 09 765488331</div>
            </div>
        </div>
    </template>

    <template id="report_consignment_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="tha_consignment_sale.consignment_order_report_body">
                        <t t-set="font_size" t-value="'13px'"/>
                        <t t-set="top_padding" t-value="'155px'"/>
                        <t t-set="page_height" t-value="'340mm'"/>
                        <t t-set="sign_bottom" t-value="'30mm'"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_consignment_order_document_a5">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="tha_consignment_sale.consignment_order_report_body">
                        <t t-set="font_size" t-value="'9.5px'"/>
                        <t t-set="top_padding" t-value="'118px'"/>
                        <t t-set="page_height" t-value="'235mm'"/>
                        <t t-set="sign_bottom" t-value="'22mm'"/>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>

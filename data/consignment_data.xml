<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_consignment_order" model="ir.sequence">
            <field name="name">Consignment Order</field>
            <field name="code">tha.consignment.order</field>
            <field name="prefix">CON/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_consignment_settlement" model="ir.sequence">
            <field name="name">Consignment Settlement</field>
            <field name="code">tha.consignment.settlement</field>
            <field name="prefix">CST/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_consignment_return" model="ir.sequence">
            <field name="name">Consignment Return</field>
            <field name="code">tha.consignment.return</field>
            <field name="prefix">CSR/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_picking_consignment_issue" model="ir.sequence">
            <field name="name">Consignment Issue Transfer</field>
            <field name="prefix">CON/ISS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_picking_consignment_sold" model="ir.sequence">
            <field name="name">Consignment Sold Transfer</field>
            <field name="prefix">CON/SOLD/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_picking_consignment_return" model="ir.sequence">
            <field name="name">Consignment Return Transfer</field>
            <field name="prefix">CON/RET/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="picking_type_consignment_issue" model="stock.picking.type">
            <field name="name">Consignment Issue</field>
            <field name="code">internal</field>
            <field name="sequence_code">CONISS</field>
            <field name="sequence_id" ref="seq_picking_consignment_issue"/>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="use_create_lots">False</field>
            <field name="use_existing_lots">True</field>
            <field name="active" eval="False"/>
        </record>

        <record id="picking_type_consignment_sold" model="stock.picking.type">
            <field name="name">Consignment Sold</field>
            <field name="code">outgoing</field>
            <field name="sequence_code">CONSOLD</field>
            <field name="sequence_id" ref="seq_picking_consignment_sold"/>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
            <field name="use_create_lots">False</field>
            <field name="use_existing_lots">True</field>
            <field name="active" eval="False"/>
        </record>

        <record id="picking_type_consignment_return" model="stock.picking.type">
            <field name="name">Consignment Return</field>
            <field name="code">internal</field>
            <field name="sequence_code">CONRET</field>
            <field name="sequence_id" ref="seq_picking_consignment_return"/>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock.stock_location_stock"/>
            <field name="use_create_lots">False</field>
            <field name="use_existing_lots">True</field>
            <field name="active" eval="False"/>
        </record>

        <record id="product_consignment_commission" model="product.template">
            <field name="name">Consignment Commission</field>
            <field name="type">service</field>
            <field name="sale_ok">False</field>
            <field name="purchase_ok">True</field>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
        </record>
    </data>

</odoo>
